# MVP 默认启用 Mock 模式，不配置 API Key 也可以生成示例学习报告。
AI_PROVIDER=mock

# DeepSeek 真实 API。启用时把 AI_PROVIDER 改为 deepseek，并在后端环境变量中配置 Key。
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Kimi / Moonshot 真实 API。没有 KIMI_API_KEY 时会自动 fallback 到 Mock。
# AI_PROVIDER=kimi
# KIMI_API_KEY=sk-xxxx
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=moonshot-v1-8k

# OpenAI 真实 API。模型名可在 OPENAI_MODEL 中自由配置。
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

# 通义千问预留。
# AI_PROVIDER=qwen
# QWEN_API_KEY=sk-xxxx
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# 豆包 Doubao 预留。
# AI_PROVIDER=doubao
# DOUBAO_API_KEY=sk-xxxx
# DOUBAO_BASE_URL=
# DOUBAO_MODEL=

# 智谱 GLM / Zhipu 预留。
# AI_PROVIDER=zhipu
# ZHIPU_API_KEY=sk-xxxx
# ZHIPU_BASE_URL=
# ZHIPU_MODEL=

# 腾讯混元 Hunyuan 预留。
# AI_PROVIDER=hunyuan
# HUNYUAN_API_KEY=sk-xxxx
# HUNYUAN_BASE_URL=
# HUNYUAN_MODEL=

# 海外模型预留。
# ANTHROPIC_API_KEY=sk-ant-xxxx
# GEMINI_API_KEY=xxxx
